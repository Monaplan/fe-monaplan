NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # atau anon key
SUPABASE_SECRET_KEY=                      # atau service role key, hanya di server
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
RESEND_API_KEY=
EMAIL_FROM="Monaplan <halo@domainkamu.com>"

# SEO (opsional): kode verifikasi Google Search Console
GOOGLE_SITE_VERIFICATION=

# Cloudflare R2 (penyimpanan berkas). Kosongkan untuk tetap memakai Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=monaplan-files
# STORAGE_DRIVER=r2        # opsional: paksa r2 atau supabase

# Google Calendar (sinkron jadwal). Kosongkan untuk menyembunyikan fitur ini.
# Redirect URI di Google Cloud: {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kunci enkripsi token Google (opsional; bila kosong memakai SUPABASE_SECRET_KEY)
TOKEN_ENCRYPTION_KEY=

# Pengingat terjadwal: rahasia untuk memanggil /api/cron/reminders (acak, minimal 32 karakter)
CRON_SECRET=
# Email dukungan: penerima tiket bantuan dan alamat balasan email
SUPPORT_EMAIL=

# Domain berkas sendiri lewat Cloudflare Worker (workers/files). Kosongkan untuk memakai alamat R2 langsung.
# FILES_BASE_URL contoh: https://files.domainmu.com ; FILES_SIGNING_SECRET acak minimal 32 karakter, sama dengan rahasia di Worker
FILES_BASE_URL=
FILES_SIGNING_SECRET=

# Login Google lewat alur aplikasi (layar Google menampilkan domainmu, bukan supabase.co). Isi 1 hanya setelah GOOGLE_CLIENT_ID
# ditambahkan ke "Authorized Client IDs" di Supabase > Authentication > Providers > Google, dan redirect URI /api/auth/google/callback didaftarkan di Google.
GOOGLE_OWN_LOGIN=
